# Required: @tailwindcss/vite@4.x peerDependencies declares vite "^5||^6||^7"
# but this project uses Vite 8. This flag suppresses the peer conflict until
# @tailwindcss/vite adds Vite 8 to its peerDependencies declaration.
# TODO: Remove this flag once @tailwindcss/vite releases Vite 8 compatibility.
legacy-peer-deps=true
